# Qualified Pocket Terminal release inputs, appended after
# sdkconfig.pocket.defaults. No credentials.
# Epoch 8: asynchronous playback from the epoch-7 one-pet layout. USB
# firmware updates only; pets up to 10,739,712 bytes install over Wi-Fi.
CONFIG_PET_VNEXT_FIRMWARE_EPOCH=8
# The qualified rollback bootloader of released Pocket Terminals. The USB
# migration to one-pet-10m-v5 keeps it. A board whose physical bytes
# differ reports no bootloader profile. USB-only pet installs do not require
# OTA boot state or rollback qualification. Migration still verifies the pin.
CONFIG_PET_VNEXT_BOOTLOADER_BYTES=22304
CONFIG_PET_VNEXT_BOOTLOADER_SHA256="7558d442cbeb03d88cd9c41129788ed500cf102343a1c4e16dcb45f190dfca43"

# Byte-reproducible release builds: no build date or absolute paths in the
# bootloader or the app. An app-only install then equals the release export's
# firmware.bin for the same commit, and the bootloader equals the qualified
# profile above.
CONFIG_APP_REPRODUCIBLE_BUILD=y
